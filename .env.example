# ============================================================
# Smart Financial Inbox — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# ============================================================

# ------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_parser

# ------------------------------------------------------------
# Optional AI providers (Required for AI categorization)
# ------------------------------------------------------------
# Get your free API key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------
# Google Sheets (future — not needed for MVP copy-paste flow)
# ------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
