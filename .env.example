# ============================================================
# Finance Parser — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# ============================================================

# ------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_parser

# ------------------------------------------------------------
# Authentication (Required for securing the app)
# ------------------------------------------------------------
APP_PASSWORD=password_rahasia_anda
AUTH_SECRET=rahasia_untuk_cookie_session

# ------------------------------------------------------------
# Optional AI providers (Required for AI categorization)
# ------------------------------------------------------------
# Which AI Provider to use? Options: gemini (default), swiftrouter
AI_PROVIDER=gemini

# --- GEMINI ---
# Get your free API key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# List of available models (comma-separated)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash-exp

# --- SWIFTROUTER ---
SWIFTROUTER_API_KEY=
# List of available models (comma-separated)
SWIFTROUTER_MODELS=google/gemini-2.5-flash,openai/gpt-4o-mini

# ------------------------------------------------------------
# Google Sheets (future — not needed for MVP copy-paste flow)
# ------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------
# Cloudinary (Required for Receipt Scanning)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
